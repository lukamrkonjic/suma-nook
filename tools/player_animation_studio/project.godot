; Standalone Godot project. This utility is intentionally not part of Suma's game runtime.
config_version=5

[application]

config/name="Suma Player Animation Studio"
run/main_scene="res://main.tscn"

[display]

window/size/viewport_width=1500
window/size/viewport_height=900
window/size/window_width_override=1500
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.055, 0.061, 0.071, 1)
