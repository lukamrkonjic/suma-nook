; Imota Tilegarden — standalone Godot project.
config_version=5

[application]

config/name="Imota Tilegarden"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6")
config/default_bus_layout="res://default_bus_layout.tres"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=true
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.914, 0.89, 0.788, 1)
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3

[audio]

driver/enable_input=false
