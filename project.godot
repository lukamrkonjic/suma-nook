[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
; Smoothness pass: native-resolution rendering, 8x MSAA for geometry plus FXAA
; for post-composited water edges, 16x anisotropic, automatic mesh LOD disabled. See
; docs/visual_rework/SMOOTHNESS_AUDIT.md.
anti_aliasing/quality/msaa_3d=3
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=false
anti_aliasing/quality/use_debanding=true
textures/default_filters/anisotropic_filtering_level=4
mesh_lod/lod_change/threshold_pixels=0.0
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
environment/defaults/default_clear_color=Color(0.9137, 0.8863, 0.8118, 1)

[audio]

driver/enable_input=false
